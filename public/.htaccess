DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preserve authorization headers
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # CarEase PHP backend API
    RewriteRule ^carease(/.*)?$ index.php?carease_route=carease$1 [END,QSA]

    # Allow existing files and folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [END]

    # Vue frontend routes
    RewriteRule ^ index.html [END]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|package\.json|package-lock\.json|\.git)">
    Require all denied
</FilesMatch>