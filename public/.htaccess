<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route CarEase backend requests to LavaLust
    RewriteRule ^carease(/.*)?$ index.php?carease_route=carease$1 [END,QSA]

    # Allow existing files and folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route Vue frontend requests
    RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|package\.json|package-lock\.json|\.git)">
    Require all denied
</FilesMatch>